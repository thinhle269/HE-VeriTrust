        <mxCell id="e_a8_c4" value="broadcast w&lt;sup&gt;r+1&lt;/sup&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6C7178;strokeWidth=3;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a8" target="c4">
